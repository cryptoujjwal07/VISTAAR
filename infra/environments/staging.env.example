# ==============================================================================
# VISTAAR — Staging Environment Configuration
# Pre-production QA & Editorial Verification Tier (NIC / MoES Staging)
# ==============================================================================
NODE_ENV=production
ENVIRONMENT=staging
LOG_LEVEL=INFO

NEXT_PUBLIC_APP_URL=https://staging.vistaar.ncpor.res.in
NEXT_PUBLIC_API_URL=https://staging-api.vistaar.ncpor.res.in/api/v1
PORT=3000
API_PORT=8000

# Injected via CI/CD Secret Store (GitHub Environment: staging)
MONGODB_URI=${STAGING_MONGODB_URI}
MONGODB_DB_NAME=vistaar_staging

REDIS_URL=${STAGING_REDIS_URL}
USE_IN_MEMORY_QUEUE=false

JWT_SECRET=${STAGING_JWT_SECRET}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_PROVIDER=gemini
GEMINI_API_KEY=${STAGING_GEMINI_API_KEY}
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=vistaar-polar-assets-staging
AWS_REGION=ap-south-1

RATE_LIMIT_PER_MINUTE=180
LOGIN_RATE_LIMIT_PER_MINUTE=15
