# ==============================================================================
# VISTAAR — Development Environment Configuration
# Isolated local development settings (Never use in staging or production)
# ==============================================================================
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=DEBUG

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
API_PORT=8000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vistaar_dev

REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=true

JWT_SECRET=CHANGE_ME_IN_LOCAL_ENV_ONLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_PROVIDER=gemini
GEMINI_API_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage_dev

RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=30
