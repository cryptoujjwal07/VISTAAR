# ==============================================================================
# VISTAAR — Production Environment Configuration
# Official NCPOR / MoES Sovereign Production Tier (NIC MeghRaj / Production Cloud)
# ==============================================================================
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

NEXT_PUBLIC_APP_URL=https://vistaar.ncpor.res.in
NEXT_PUBLIC_API_URL=https://api.vistaar.ncpor.res.in/api/v1
PORT=3000
API_PORT=8000

# Injected strictly via Production Secret Vault (GitHub Environment: production)
MONGODB_URI=${PROD_MONGODB_URI}
MONGODB_DB_NAME=vistaar_production

REDIS_URL=${PROD_REDIS_URL}
USE_IN_MEMORY_QUEUE=false

JWT_SECRET=${PROD_JWT_SECRET}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_PROVIDER=gemini
GEMINI_API_KEY=${PROD_GEMINI_API_KEY}
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=vistaar-polar-assets-prod
AWS_REGION=ap-south-1

RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
