# System Environment (development | staging | production)
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
API_PORT=8000

# Database Configuration (MongoDB Atlas)
# Provided connection string:
MONGODB_URI=mongodb+srv://ayushmang06_db_user:1234567890@polarbearvistaar.qmtf9h5.mongodb.net/?appName=polarbearVISTAAR
MONGODB_DB_NAME=vistaar_production

# Redis & Asynchronous Worker Queue
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=true

# Authentication & Security (JWT)
JWT_SECRET=vistaar_secure_production_secret_key_polar_science_2026_ncpor
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Admin Seed (Initial system setup)
SUPER_ADMIN_EMAIL=admin@vistaar.ncpor.res.in
SUPER_ADMIN_PASSWORD=VistaarAdmin@2026!

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
# Supported AI_PROVIDER: gemini | openai | mock_deterministic
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Digital India Bhashini Localization (Optional, falls back to deterministic/neural provider)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Object Storage / File Uploads
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET_NAME=vistaar-polar-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
